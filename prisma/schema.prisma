generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Temporary — proves the pipeline works end-to-end.
// We replace this with the real schema (User, Application, Interview) in Phase 3.
model ConnectionTest {
  id        Int      @id @default(autoincrement())
  message   String
  createdAt DateTime @default(now())
}